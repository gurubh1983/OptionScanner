# StrikeGenius.ai Backend — copy to .env and fill
APP_NAME=StrikeGenius.ai
DEBUG=true
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://strikegenius:strikegenius@localhost:5432/strikegenius
DATABASE_URL_SYNC=postgresql://strikegenius:strikegenius@localhost:5432/strikegenius
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=your-secret-key-use-hsm-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Broker (pluggable: angel_one | dhan | zerodha)
BROKER_ADAPTER=angel_one
ANGEL_ONE_API_KEY=
DHAN_API_KEY=
ZERODHA_API_KEY=

# Market data pipeline (WebSocket hardening)
FEED_HEARTBEAT_INTERVAL_SEC=30
FEED_LAG_THRESHOLD_SEC=60
FEED_RECONNECT_MAX_RETRIES=10
FEED_RECONNECT_BASE_DELAY_SEC=1
FEED_RECONNECT_MAX_DELAY_SEC=120
FEED_TOKEN_REFRESH_BEFORE_EXPIRY_SEC=300
FEED_FALLBACK_ENABLED=true

# Billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FREE_SCANS_PER_DAY=5
FREE_ALERTS_PER_DAY=5
