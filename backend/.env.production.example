# StrikeGenius.ai — Production (copy to .env and set values)
# Use for Railway, Render, or any production host.

ENVIRONMENT=production
DEBUG=false

# Database (e.g. Neon, Supabase, Railway Postgres)
# Async: postgresql+asyncpg://user:pass@host/db
# Sync (Alembic): postgresql://user:pass@host/db
DATABASE_URL=postgresql+asyncpg://user:pass@neon.tech/db
DATABASE_URL_SYNC=postgresql://user:pass@neon.tech/db

# JWT (required in production; use a long random secret)
JWT_SECRET=supersecretkey
# Or: SECRET_KEY=supersecretkey

# CORS — comma-separated frontend origins (e.g. Vercel)
CORS_ORIGINS=https://yourapp.vercel.app,https://www.yourapp.vercel.app

# Billing
RAZORPAY_KEY_ID=xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
# Optional: Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional: Redis (for workers/cache)
REDIS_URL=redis://default:pass@host:6379/0

# Free tier limits
FREE_SCANS_PER_DAY=5
FREE_ALERTS_PER_DAY=5
